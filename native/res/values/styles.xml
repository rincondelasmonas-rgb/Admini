<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/archivos_bg</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/archivos_surface</item>
        <item name="android:navigationBarColor">@color/archivos_bg</item>
        <item name="android:windowLightStatusBar">@bool/archivos_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/archivos_light_bars</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">@color/archivos_bg</item>
        <item name="android:windowSplashScreenBackground">@color/archivos_bg</item>
    </style>

</resources>
